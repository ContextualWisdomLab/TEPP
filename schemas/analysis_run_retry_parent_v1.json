{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tepp.local/schemas/analysis_run_retry_parent_v1.json",
  "title": "AnalysisRunRetryParentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "run_state",
    "idempotency_key",
    "parent"
  ],
  "properties": {
    "contract_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
    "run_state": {
      "type": "string",
      "enum": ["accepted", "running", "succeeded", "failed", "cancelled"]
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
    "parent": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "run_state", "idempotency_key"],
          "properties": {
            "run_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
            "run_state": {
              "type": "string",
              "enum": ["accepted", "running", "succeeded", "failed", "cancelled"]
            },
            "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" }
          }
        }
      ]
    }
  }
}
